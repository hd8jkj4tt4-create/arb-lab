# ---------------------------------------------------------------------------
# Arb Lab configuration. Copy to .env and edit.
#   cp .env.example .env
# Every value can also be exported in your shell.
# ---------------------------------------------------------------------------

# demo       simulated football & NBA odds (no key, always works)
# theoddsapi live odds via the-odds-api.com (free tier exists; NO Sisal)
# oddsapiio  live odds via odds-api.io (paid; includes Sisal/Snai/Eurobet)
PROVIDER=demo

# --- The Odds API (https://the-odds-api.com) --------------------------------
ODDS_API_KEY=
# Comma-separated bookmaker keys. Leave empty to use REGIONS instead.
# Example: unibet_it,betsson
BOOKMAKERS=
# Used only when BOOKMAKERS is empty. EU covers Italian-facing books.
REGIONS=eu

# --- Odds-API.io (https://odds-api.io) --------------------------------------
ODDS_API_IO_KEY=
# Exact names from your odds-api.io plan. Required when PROVIDER=oddsapiio.
# Example: BOOKMAKERS=Sisal IT,Snai IT
# (BOOKMAKERS above is shared by both live providers.)

# --- Coverage ---------------------------------------------------------------
# The Odds API sport keys. Empty = all tracked competitions:
# Serie A, Serie B, Coppa Italia, Champions League, La Liga, NBA.
# More sports = more API credits per scan.
SPORTS=soccer_italy_serie_a,soccer_italy_serie_b,soccer_italy_coppa_italia,soccer_uefa_champs_league,soccer_spain_la_liga,basketball_nba
# odds-api.io sports to query (football + basketball by default).
ODDS_API_IO_SPORTS=football,basketball

# --- Scanner ---------------------------------------------------------------
# Seconds between scans (minimum 30). Live quotas: keep this high.
POLL_SECONDS=300
# Minutes between ESPN refreshes (minimum 5). Finished matches only.
PREDICTIONS_REFRESH_MINUTES=30
BANKROLL=1000
# Only alert when S is at or below this value (0.985 = 1.5% edge).
THRESHOLD=0.985
MIN_STAKE=0.5

# --- Server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8765

# --- Optional Telegram alerts ----------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
